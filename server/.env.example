# Copy this file to server/.env to change settings. Everything is optional.

# Port the API listens on
PORT=5000

# Leave MONGO_URI empty (the default) and NewsNest never connects to any
# database: stories live in memory and reset when the server restarts.
# Only set this if you deliberately want to use MongoDB.
# MONGO_URI=mongodb://127.0.0.1:27017/newsnest

# Simulates a slow network. Each API call waits a random time between
# 0 and this many milliseconds. Set to 0 to turn it off.
API_DELAY_MS=700

# Rate limiting for publishing articles (POST /api/articles)
# Maximum number of articles a client can publish within the window
RATE_LIMIT_MAX=5
# Time window for rate limiting in milliseconds (default: 60000ms = 1 minute)
RATE_LIMIT_WINDOW_MS=60000
